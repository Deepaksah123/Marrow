<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/marrow_background">
<LinearLayout android:id="@+id/homeHeader" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="4dp" android:background="@color/marrow_primary">
<TextView android:id="@+id/homeMenu" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="☰" android:textColor="@android:color/white" android:textSize="22sp"/>
<TextView android:id="@+id/homeTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Home" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/homeSearch" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="⌕" android:contentDescription="Search" android:textColor="@android:color/white" android:textSize="27sp"/>
<TextView android:id="@+id/homeBookmark" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="★" android:contentDescription="Bookmarks" android:textColor="@android:color/white" android:textSize="18sp"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/homeFeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MCQ of the Day" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:padding="4dp"/>
<LinearLayout android:id="@+id/homeMcqCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MCQ of the Day" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suggested Test" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:paddingTop="16dp" android:paddingBottom="4dp"/>
<LinearLayout android:id="@+id/homeTestCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Suggested Test" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suggested Question Bank" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:paddingTop="16dp" android:paddingBottom="4dp"/>
<LinearLayout android:id="@+id/homeQBankCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Suggested Question Bank" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suggested Video" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:paddingTop="16dp" android:paddingBottom="4dp"/>
<LinearLayout android:id="@+id/homeVideoCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Suggested Video" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pearls" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:paddingTop="16dp" android:paddingBottom="4dp"/>
<LinearLayout android:id="@+id/homePearlsCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pearls" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recent Updates" android:textColor="@color/marrow_text" android:textSize="13sp" android:textStyle="bold" android:paddingTop="16dp" android:paddingBottom="4dp"/>
<LinearLayout android:id="@+id/homeRecentCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:padding="14dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Updates" android:textColor="@color/marrow_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/marrow_muted" android:textSize="24sp"/></LinearLayout>
<Button android:id="@+id/homeShare" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="➤  Share Marrow"/>
</LinearLayout></ScrollView></LinearLayout>