<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/homeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Featured" android:textSize="18sp" android:textStyle="bold" android:paddingTop="20dp"/>
        <LinearLayout android:id="@+id/featuredContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QBank" android:textSize="18sp" android:textStyle="bold" android:paddingTop="20dp"/>
        <TextView android:id="@+id/homeQBankSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Question Bank" android:padding="16dp" android:background="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tests" android:textSize="18sp" android:textStyle="bold" android:paddingTop="20dp"/>
        <TextView android:id="@+id/homeTestSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tests" android:padding="16dp" android:background="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Videos" android:textSize="18sp" android:textStyle="bold" android:paddingTop="20dp"/>
        <TextView android:id="@+id/homeVideoSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Videos" android:padding="16dp" android:background="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
