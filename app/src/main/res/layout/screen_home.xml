<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/marrow_background">

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:background="@color/marrow_primary"
        android:elevation="4dp">
        <TextView
            android:id="@+id/homeMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:contentDescription="Menu"/>
        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Home"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/homeSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_marrow_search"
            android:contentDescription="Search"
            android:scaleType="center"/>
        <ImageButton
            android:id="@+id/homeBookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_marrow_bookmark"
            android:tint="@android:color/white"
            android:contentDescription="Bookmarks"
            android:scaleType="center"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/homeFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/homeEditionBanner"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="18dp"
                android:src="@drawable/ic_edition_8_5_mobile"
                android:scaleType="centerCrop"
                android:contentDescription="Edition 8.5"/>

            <TextView
                android:id="@+id/homeLocalSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QBank"
                android:textColor="@color/marrow_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="2dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/homeQBankCard"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/icv_fc_qbank"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question Bank"
                        android:textColor="@color/marrow_text"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/homeQBankSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Edition 8 · verified local content"
                        android:textColor="@color/marrow_muted"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/marrow_muted"
                    android:textSize="28sp"/>
            </LinearLayout>

            <!-- Recovered Home state exposes these surfaces, but their live
                 payload/configuration is not locally verified. Keep the IDs
                 for future evidence-backed wiring; never populate them with
                 invented content. -->
            <LinearLayout android:id="@+id/homeZenCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeTestCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeVideoCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeMagicModuleCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homePearlsCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeFeatureCards" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homePlanUpgrade" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeRecentCard" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
            <Button android:id="@+id/homeShare" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>