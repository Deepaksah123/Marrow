<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Custom Module" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<TextView android:id="@+id/customFlow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Create a module from the native Custom Module flow" android:textSize="13sp" android:textColor="@color/marrow_muted"/>
<LinearLayout android:id="@+id/customCreationCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create Custom Module" android:textSize="17sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Select the module mode, subjects, topics, tags and add-ons." android:textSize="13sp" android:textColor="@color/marrow_muted"/>
<Button android:id="@+id/customNext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Continue" android:textAllCaps="false"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="MODULE SETUP" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<LinearLayout android:id="@+id/customModeState" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mode Selection" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/customSubjectState" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Subjects Selection" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/customTopicState" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Topics Selection" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/customTagState" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tags Selection" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/customAddonState" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add-ons Selection" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/customJoinState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Join by Code" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Native join-by-code surface is available in the recovered UI." android:textSize="13sp" android:textColor="@color/marrow_muted"/></LinearLayout>
<LinearLayout android:id="@+id/customScoreState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Score / Review" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Dedicated native score and review surfaces are preserved as the downstream state." android:textSize="13sp" android:textColor="@color/marrow_muted"/></LinearLayout>
</LinearLayout></ScrollView>