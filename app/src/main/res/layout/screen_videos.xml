<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Videos" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Landing · lessons · revision · notes · downloaded · sample" android:textSize="13sp" android:textColor="@color/marrow_muted" android:paddingTop="4dp"/>
<LinearLayout android:id="@+id/videoQuickSurfaces" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/videoDownloaded" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Downloaded" android:textAllCaps="false"/>
<Button android:id="@+id/videoSample" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sample Videos" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/videoRevisionCard" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="World of Revision" android:textSize="15sp" android:textStyle="bold"/>
<Button android:id="@+id/videoRevision" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPEN" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/videoNotesCard" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notes" android:textSize="15sp" android:textStyle="bold"/>
<Button android:id="@+id/videoNotes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPEN" android:textAllCaps="false"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUBJECTS" android:textSize="17sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="8dp"/>
<TextView android:id="@+id/videoSubjectState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Video subject catalog is server-backed; local subject payload is not bundled." android:textSize="14sp" android:textColor="@color/marrow_muted" android:paddingBottom="12dp"/>
<Button android:id="@+id/videoSubjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPEN VIDEO SUBJECTS" android:textAllCaps="false"/>
</LinearLayout></ScrollView>