<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/marrow_background">
        <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:background="@color/marrow_surface" android:elevation="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/navHome" style="@style/MarrowNav" android:text="Home" android:drawableTop="@drawable/ic_home_tab_home" android:drawablePadding="2dp" android:drawableTint="@color/marrow_nav_icon_tint"/>
            <TextView android:id="@+id/navQBank" style="@style/MarrowNav" android:text="QBank" android:drawableTop="@drawable/ic_home_tab_qbank" android:drawablePadding="2dp" android:drawableTint="@color/marrow_nav_icon_tint"/>
            <TextView android:id="@+id/navTests" style="@style/MarrowNav" android:text="Tests" android:drawableTop="@drawable/ic_home_tab_tests" android:drawablePadding="2dp" android:drawableTint="@color/marrow_nav_icon_tint"/>
            <TextView android:id="@+id/navVideos" style="@style/MarrowNav" android:text="Videos" android:drawableTop="@drawable/ic_home_tab_videos" android:drawablePadding="2dp" android:drawableTint="@color/marrow_nav_icon_tint"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/homeDrawer" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="vertical" android:background="@color/marrow_surface" android:elevation="16dp" android:paddingTop="28dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="18dp">
            <ImageView android:layout_width="22dp" android:layout_height="38dp" android:src="@drawable/ic_marrow_logo_large" android:contentDescription="Marrow"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marrow" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medical learning" android:textSize="12sp" android:textColor="@color/marrow_muted" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/marrow_divider"/>
        <TextView android:id="@+id/drawerSearch" style="@style/MarrowDrawerItem" android:text="Search"/>
        <TextView android:id="@+id/drawerBookmarks" style="@style/MarrowDrawerItem" android:text="Bookmarks"/>
        <TextView android:id="@+id/drawerCustom" style="@style/MarrowDrawerItem" android:text="Custom Module"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/marrow_divider"/>
        <TextView android:id="@+id/drawerProfile" style="@style/MarrowDrawerItem" android:text="Profile"/>
        <TextView android:id="@+id/drawerSettings" style="@style/MarrowDrawerItem" android:text="Settings"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>