<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/bookmarkTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bookmarks" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:id="@+id/bookmarkSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved questions, videos and timeline" android:textSize="13sp" android:textColor="@color/marrow_muted" android:paddingTop="6dp" android:paddingBottom="14dp"/>
<LinearLayout android:id="@+id/bookmarkSurfaceTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_home_card" android:padding="4dp">
<Button android:id="@+id/bookmarkQuestionsTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="QUESTIONS" android:textAllCaps="false"/>
<Button android:id="@+id/bookmarkVideoTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VIDEO" android:textAllCaps="false"/>
<Button android:id="@+id/bookmarkTimelineTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TIMELINE" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/bookmarkScopeTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp">
<Button android:id="@+id/bookmarkAllTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ALL LOADED" android:textAllCaps="false"/>
<Button android:id="@+id/bookmarkCurrentTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CURRENT MODULE" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_home_card">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved items" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/bookmarkState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/marrow_muted" android:paddingTop="6dp" android:paddingBottom="10dp"/>
<LinearLayout android:id="@+id/bookmarkList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
</LinearLayout></ScrollView>