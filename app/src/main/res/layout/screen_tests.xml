<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/marrow_background" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="92dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_home_card" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tests"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="" android:textSize="12sp" android:textColor="@color/marrow_muted"/>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/testConfiguredTabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                <Button android:id="@+id/testGrandTab" android:layout_width="112dp" android:layout_height="44dp" android:text="Grand Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testMiniTab" android:layout_width="102dp" android:layout_height="44dp" android:text="Mini Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectTab" android:layout_width="104dp" android:layout_height="44dp" android:text="Subject Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectFilterTab" android:layout_width="92dp" android:layout_height="44dp" android:text="All Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectOnlyTab" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView android:id="@+id/testYear" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="TEST SERIES" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/marrow_muted"
            android:paddingTop="10dp" android:paddingBottom="8dp"/>
        <LinearLayout android:id="@+id/testListCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_home_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text=""
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
            <TextView android:id="@+id/testPayloadState" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="" android:textSize="12sp" android:textColor="@color/marrow_muted"/>
            <Button android:id="@+id/testStart" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="14dp" android:text="Open Test Introduction" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView android:id="@+id/testMonthRow" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"
            android:gravity="center_vertical" android:text="This Month    ·    Test schedule" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/marrow_text" android:background="@drawable/bg_home_card" android:paddingStart="14dp" android:paddingEnd="10dp"/>
        <TextView android:id="@+id/testPreviousYearRow" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp"
            android:gravity="center_vertical" android:text="Previous Year    ·    Archive" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/marrow_text" android:background="@drawable/bg_home_card" android:paddingStart="14dp" android:paddingEnd="10dp"/>

        <TextView android:id="@+id/testGrandNudge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GRAND TEST" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/marrow_muted"
            android:paddingTop="22dp" android:paddingBottom="8dp"/>
        <LinearLayout android:id="@+id/testGrandAnalyticsCard" android:layout_width="match_parent" android:layout_height="64dp"
            android:background="@drawable/bg_home_card" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Grand Test Analytics"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
            <Button android:id="@+id/testAnalytics" android:layout_width="wrap_content" android:layout_height="44dp" android:text="OPEN" android:textAllCaps="false"/>
        </LinearLayout>
        <Button android:id="@+id/testReview" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/testNativeHeaderCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>