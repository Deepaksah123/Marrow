<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tests" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="200 MCQ · Grand · All · Mini · Subject · score / analytics" android:textSize="13sp" android:textColor="@color/marrow_muted"/>
<LinearLayout android:id="@+id/testConfiguredTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/testGrandTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="200 MCQ" android:textAllCaps="false"/>
<Button android:id="@+id/testMiniTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Grand" android:textAllCaps="false"/>
<Button android:id="@+id/testSubjectTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="All" android:textAllCaps="false"/>
<Button android:id="@+id/testSubjectFilterTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mini" android:textAllCaps="false"/><Button android:id="@+id/testSubjectOnlyTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Subject" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:id="@+id/testNativeHeaderCard" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Test Header" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current Test Cycle" android:textSize="12sp" android:textColor="@color/marrow_muted"/></LinearLayout><TextView android:id="@+id/testYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current Year" android:textSize="17sp" android:textStyle="bold" android:paddingTop="18dp" android:paddingBottom="8dp" android:textColor="@color/marrow_text"/>
<LinearLayout android:id="@+id/testListCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test List" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/testPayloadState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Live test payload is not bundled locally." android:textSize="13sp" android:textColor="@color/marrow_muted"/>
<Button android:id="@+id/testStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Open Test Introduction" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/testMonthRow" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="This Month" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Test schedule" android:textSize="12sp" android:textColor="@color/marrow_muted"/></LinearLayout><LinearLayout android:id="@+id/testPreviousYearRow" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Previous Year" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Archive" android:textSize="12sp" android:textColor="@color/marrow_muted"/></LinearLayout><TextView android:id="@+id/testGrandNudge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grand Test" android:textSize="17sp" android:textStyle="bold" android:paddingTop="18dp" android:paddingBottom="8dp"/>
<LinearLayout android:id="@+id/testGrandAnalyticsCard" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Grand Test Analytics" android:textSize="15sp" android:textStyle="bold"/>
<Button android:id="@+id/testAnalytics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPEN" android:textAllCaps="false"/>
</LinearLayout>
<Button android:id="@+id/testReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Review / Analytics" android:textAllCaps="false"/>
</LinearLayout></ScrollView>