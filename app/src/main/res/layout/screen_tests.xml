<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/marrow_primary" android:paddingStart="16dp" android:paddingEnd="16dp">
<ImageView android:layout_width="25dp" android:layout_height="30dp" android:src="@drawable/ic_test_header" android:contentDescription="@null"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp" android:text="Tests" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="200 MCQ  ·  Grand  ·  All  ·  Mini  ·  Subject" android:textSize="12sp" android:textColor="@color/marrow_muted"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:scrollbars="none">
<LinearLayout android:id="@+id/testConfiguredTabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
<Button android:id="@+id/testGrandTab" android:layout_width="110dp" android:layout_height="44dp" android:text="200 MCQ" android:textAllCaps="false"/>
<Button android:id="@+id/testMiniTab" android:layout_width="100dp" android:layout_height="44dp" android:text="Grand" android:textAllCaps="false"/>
<Button android:id="@+id/testSubjectTab" android:layout_width="90dp" android:layout_height="44dp" android:text="All" android:textAllCaps="false"/>
<Button android:id="@+id/testSubjectFilterTab" android:layout_width="90dp" android:layout_height="44dp" android:text="Mini" android:textAllCaps="false"/>
<Button android:id="@+id/testSubjectOnlyTab" android:layout_width="100dp" android:layout_height="44dp" android:text="Subject" android:textAllCaps="false"/>
</LinearLayout></HorizontalScrollView>
<LinearLayout android:id="@+id/testNativeHeaderCard" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="4dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp">
<TextView android:id="@+id/testYear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Current Test Cycle · 200 MCQ" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current" android:textSize="12sp" android:textColor="@color/marrow_muted"/>
</LinearLayout>
<LinearLayout android:id="@+id/testListCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test List" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/testPayloadState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Live test payload is not bundled locally." android:textSize="12sp" android:textColor="@color/marrow_muted"/>
<Button android:id="@+id/testStart" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="Open Test Introduction" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/testMonthRow" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="This Month" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule" android:textSize="12sp" android:textColor="@color/marrow_muted"/></LinearLayout>
<LinearLayout android:id="@+id/testPreviousYearRow" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Previous Year" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Archive" android:textSize="12sp" android:textColor="@color/marrow_muted"/></LinearLayout>
<TextView android:id="@+id/testGrandNudge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grand Test" android:textSize="16sp" android:textStyle="bold" android:paddingTop="14dp" android:paddingBottom="6dp"/>
<LinearLayout android:id="@+id/testGrandAnalyticsCard" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Grand Test Analytics" android:textSize="15sp" android:textStyle="bold"/><Button android:id="@+id/testAnalytics" android:layout_width="wrap_content" android:layout_height="44dp" android:text="OPEN" android:textAllCaps="false"/></LinearLayout>
<Button android:id="@+id/testReview" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Review / Analytics" android:textAllCaps="false"/>
</LinearLayout></ScrollView>