<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="82dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tests"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_text"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/marrow_muted"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/testConfiguredTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <Button android:id="@+id/testGrandTab" android:layout_width="110dp" android:layout_height="44dp" android:text="Grand Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testMiniTab" android:layout_width="100dp" android:layout_height="44dp" android:text="Mini Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectTab" android:layout_width="90dp" android:layout_height="44dp" android:text="Subject Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectFilterTab" android:layout_width="90dp" android:layout_height="44dp" android:text="All Tests" android:textAllCaps="false"/>
                <Button android:id="@+id/testSubjectOnlyTab" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/> 
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/testYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TEST SERIES"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_text"/>

        <LinearLayout
            android:id="@+id/testListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/marrow_text"/>
            <TextView
                android:id="@+id/testPayloadState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/marrow_muted"/>
            <Button
                android:id="@+id/testStart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Open Test Introduction"
                android:textAllCaps="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/testMonthRow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:text="This Month    ·    Test schedule"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_text"
            android:background="@drawable/bg_home_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <TextView
            android:id="@+id/testPreviousYearRow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Previous Year    ·    Archive"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_text"
            android:background="@drawable/bg_home_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <TextView
            android:id="@+id/testGrandNudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRAND TEST"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_muted"
            android:paddingTop="18dp"
            android:paddingBottom="7dp"/>

        <LinearLayout
            android:id="@+id/testGrandAnalyticsCard"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grand Test Analytics"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/marrow_text"/>
            <Button
                android:id="@+id/testAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="OPEN"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Retained for MainActivity compatibility; not shown as a second,
             unrelated action on the landing page. -->
        <Button
            android:id="@+id/testReview"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/testNativeHeaderCard"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>