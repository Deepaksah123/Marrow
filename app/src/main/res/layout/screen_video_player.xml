<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/videoPlayerRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/marrow_surface">
<LinearLayout android:id="@+id/videoPlayerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
<TextView android:id="@+id/videoPlayerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Video Player" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<TextView android:id="@+id/videoPlayerSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:textColor="@color/marrow_muted"/>
</LinearLayout>
<FrameLayout android:id="@+id/videoPlayerSurface" android:layout_width="match_parent" android:layout_height="210dp" android:background="@color/marrow_text"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="VIDEO" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white"/></FrameLayout>
<LinearLayout android:id="@+id/videoPlayerControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/videoPlayerState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/marrow_muted"/>
<SeekBar android:id="@+id/videoProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/videoSpeedRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
<Button android:id="@+id/videoSpeedNormal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1×" android:textAllCaps="false"/>
<Button android:id="@+id/videoTimeline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Timeline" android:textAllCaps="false"/>
<Button android:id="@+id/videoNotesAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notes" android:textAllCaps="false"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Brightness" android:textSize="14sp" android:paddingTop="12dp" android:textColor="@color/marrow_text"/>
<SeekBar android:id="@+id/videoBrightness" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/videoPlayerStateCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:id="@+id/videoWatchNextState" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Watch Next" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp"/></LinearLayout>
<LinearLayout android:id="@+id/videoCompletedState" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completed / End State" android:textSize="15sp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:id="@+id/videoErrorState" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="6dp" android:background="@color/marrow_surface" android:gravity="center_vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Playback Error State" android:textSize="15sp" android:textStyle="bold"/></LinearLayout>
</LinearLayout>
<Button android:id="@+id/videoPlayerBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="14dp" android:text="BACK" android:textAllCaps="false"/>
</LinearLayout></ScrollView>