<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/marrow_background" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="12dp" android:paddingBottom="92dp">

        <LinearLayout android:id="@+id/qbankHero" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_home_card" android:padding="18dp">
            <TextView android:id="@+id/qbankTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="QBank" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
            <TextView android:id="@+id/qbankSource" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="" android:textSize="12sp" android:textColor="@color/marrow_muted"/>
            <TextView android:id="@+id/qbankTracker" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="14dp" android:gravity="center_vertical" android:text=""
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/marrow_primary"
                android:background="@drawable/bg_home_card" android:paddingStart="14dp" android:paddingEnd="14dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QBANK TOOLS"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/marrow_muted"
            android:paddingTop="20dp" android:paddingBottom="8dp"/>
        <LinearLayout android:id="@+id/qbankQuickActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/qbankSearchActionBox" android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                android:layout_marginEnd="5dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_home_card">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_search_revamp" android:contentDescription="@null"/>
                <Button android:id="@+id/qbankSearchAction" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp"
                    android:background="@android:color/transparent" android:text="Search" android:textAllCaps="false" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/qbankBookmarkActionBox" android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_home_card">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_qbank_bookmarks" android:contentDescription="@null"/>
                <Button android:id="@+id/qbankBookmarkAction" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp"
                    android:background="@android:color/transparent" android:text="Bookmarks" android:textAllCaps="false" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/qbankCustomActionBox" android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                android:layout_marginStart="5dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_home_card">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/icv_magic_module_home_icon" android:contentDescription="@null"/>
                <Button android:id="@+id/qbankCustomAction" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp"
                    android:background="@android:color/transparent" android:text="Custom" android:textAllCaps="false" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUBJECTS"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/marrow_muted"
            android:paddingTop="22dp" android:paddingBottom="8dp"/>
        <LinearLayout android:id="@+id/subjectContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADDITIONAL"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/marrow_muted"
            android:paddingTop="22dp" android:paddingBottom="8dp"/>
        <LinearLayout android:id="@+id/qbankExtraSurfaces" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>