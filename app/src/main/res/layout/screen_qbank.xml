<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="24dp">
<LinearLayout android:id="@+id/qbankHeaderCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/marrow_surface" android:padding="16dp">
<TextView android:id="@+id/qbankTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QBank" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/marrow_text"/>
<TextView android:id="@+id/qbankSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edition 8 · verified local question source" android:textSize="13sp" android:textColor="@color/marrow_muted" android:paddingTop="5dp"/>
<TextView android:id="@+id/qbankTracker" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Progress" android:textSize="14sp" android:textStyle="bold" android:paddingTop="12dp" android:textColor="@color/marrow_primary"/>
</LinearLayout>
<LinearLayout android:id="@+id/qbankQuickActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
<Button android:id="@+id/qbankSearchAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Search" android:textAllCaps="false"/>
<Button android:id="@+id/qbankBookmarkAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bookmarks" android:textAllCaps="false"/>
<Button android:id="@+id/qbankCustomAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Custom" android:textAllCaps="false"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUBJECTS" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/marrow_text" android:paddingTop="18dp" android:paddingBottom="8dp"/>
<LinearLayout android:id="@+id/subjectContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<LinearLayout android:id="@+id/qbankExtraSurfaces" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"/>
</LinearLayout></ScrollView>