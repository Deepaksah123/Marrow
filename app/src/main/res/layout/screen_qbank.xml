<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/qbankTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QBank"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_text"/>
        <TextView
            android:id="@+id/qbankSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Edition 8 · verified local question source"
            android:textSize="13sp"
            android:textColor="@color/marrow_muted"/>

        <TextView
            android:id="@+id/qbankTracker"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:text="QBank tracker"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_primary"
            android:background="@drawable/bg_home_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOOLS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_muted"
            android:paddingTop="18dp"
            android:paddingBottom="7dp"/>

        <LinearLayout
            android:id="@+id/qbankQuickActions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/qbankSearchAction"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Search"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/qbankBookmarkAction"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Bookmarks"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/qbankCustomAction"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Custom"
                android:textAllCaps="false"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUBJECTS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_muted"
            android:paddingTop="18dp"
            android:paddingBottom="7dp"/>
        <LinearLayout
            android:id="@+id/subjectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADDITIONAL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/marrow_muted"
            android:paddingTop="18dp"
            android:paddingBottom="7dp"/>
        <LinearLayout
            android:id="@+id/qbankExtraSurfaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>