<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/marrow_primary" android:paddingStart="16dp" android:paddingEnd="16dp">
<ImageView android:layout_width="30dp" android:layout_height="32dp" android:src="@drawable/ic_qbank_header" android:contentDescription="@null"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
<TextView android:id="@+id/qbankTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QBank" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white"/>
<TextView android:id="@+id/qbankSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edition 8" android:textSize="12sp" android:textColor="@android:color/white" android:alpha="0.86"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/qbankQuickActions" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
<Button android:id="@+id/qbankSearchAction" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Search" android:textAllCaps="false"/>
<Button android:id="@+id/qbankBookmarkAction" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Bookmarks" android:textAllCaps="false" android:drawableStart="@drawable/ic_qbank_bookmarks" android:drawablePadding="6dp"/>
<Button android:id="@+id/qbankCustomAction" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Custom" android:textAllCaps="false"/>
</LinearLayout>
<TextView android:id="@+id/qbankTracker" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="QBank tracker" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/marrow_primary" android:paddingStart="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUBJECTS" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/marrow_muted" android:paddingTop="8dp" android:paddingBottom="6dp"/>
<LinearLayout android:id="@+id/subjectContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<LinearLayout android:id="@+id/qbankExtraSurfaces" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"/>
</LinearLayout></ScrollView>