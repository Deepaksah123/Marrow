<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/marrow_primary</item>
        <item name="android:navigationBarColor">@color/marrow_background</item><item name="android:statusBarColor">@color/marrow_background</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:windowBackground">@color/marrow_background</item>
        <item name="android:textColorPrimary">@color/marrow_text</item><item name="android:textColorSecondary">@color/marrow_muted</item>
        <item name="android:buttonStyle">@style/MarrowButton</item><item name="android:editTextStyle">@style/MarrowEditText</item>
    </style>
    <style name="MarrowButton" parent="@android:style/Widget.Material.Button"><item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/marrow_accent</item></style>
    <style name="MarrowEditText" parent="@android:style/Widget.Material.EditText"><item name="android:minHeight">48dp</item><item name="android:textColor">@color/marrow_accent</item><item name="android:textColorHint">@color/marrow_muted</item></style>
</resources>