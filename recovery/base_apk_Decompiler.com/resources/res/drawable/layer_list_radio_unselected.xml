<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="28dp"
                android:width="26dp"/>
            <gradient
                android:startColor="#2a000000"
                android:endColor="#0000"
                android:angle="90"/>
        </shape>
    </item>
    <item
        android:left="0.8dp"
        android:top="0.4dp"
        android:right="0.8dp"
        android:bottom="2.4dp">
        <shape android:shape="oval">
            <solid android:color="#fff"/>
            <size
                android:height="26dp"
                android:width="26dp"/>
        </shape>
    </item>
</layer-list>
