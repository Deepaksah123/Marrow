<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@android:integer/config_shortAnimTime"
    android:fromDegrees="0"
    android:toDegrees="1080"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape
        android:shape="ring"
        android:innerRadiusRatio="2.5"
        android:useLevel="true"
        android:thickness="3.8dp">
        <padding
            android:left="-6dp"
            android:top="-6dp"
            android:right="-6dp"
            android:bottom="-6dp"/>
        <size
            android:height="24dp"
            android:width="24dp"/>
        <gradient
            android:startColor="#0062c8df"
            android:endColor="#ff62c8df"
            android:useLevel="false"
            android:angle="0"
            android:type="sweep"
            android:centerY="0.5"
            android:centerColor="#62c8df"/>
    </shape>
</rotate>
